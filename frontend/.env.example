# Browser API base URL. Leave empty in dev (Vite proxies /api and /hubs).
VITE_API_BASE_URL=

# Dev only: where Vite proxies /api and /hubs (npm run dev / npm run preview)
VITE_DEV_PROXY_TARGET=https://localhost:7074

# "true" = nasconde i pulsanti Accedi e Registrati nella home
VITE_HIDE_AUTH_BUTTONS=false

# Produzione (vite build / build.ps1): lasciare vuoto — UI servita dal backend, /api e /hubs same-origin
# VITE_API_BASE_URL=
