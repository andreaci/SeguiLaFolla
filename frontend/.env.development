# Empty = same-origin requests via Vite reverse proxy (no CORS)
VITE_API_BASE_URL=

# Backend URL for Vite proxy only (not exposed to the browser)
# Match launchSettings: https profile → 7074, http profile → 5230
VITE_DEV_PROXY_TARGET=https://localhost:7074

# "true" = nasconde i pulsanti Accedi e Registrati nella home
VITE_HIDE_AUTH_BUTTONS=true
